# Copy to .env and fill in. NEVER commit .env.

# Optional fallback Hevy Pro API key; the primary path is entering it on the
# in-app settings page (stored server-side in SQLite).
HEVY_API_KEY=

# LLM provider for plan generation (via the Vercel AI SDK), e.g. "anthropic".
LLM_PROVIDER=
LLM_API_KEY=

# Optional: SQLite database file location.
DATABASE_PATH=./data/hevy-planner.sqlite
