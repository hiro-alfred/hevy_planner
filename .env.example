# Copy to .env and fill in. NEVER commit .env.

# Optional fallback Hevy Pro API key; the primary path is entering it on the
# in-app settings page (stored server-side in MariaDB). A key set here is used
# only when no key has been saved in the app.
HEVY_API_KEY=

# Optional. Points the Hevy client at a different host — only useful for trying
# the read-only screens against a local stand-in server. Leave it unset: with
# no value the client talks to https://api.hevyapp.com.
HEVY_API_BASE_URL=

# LLM used for plan generation, via the Vercel AI SDK.
#
# ALL OF THESE ARE OPTIONAL. With no LLM_API_KEY the app still generates plans,
# using the deterministic built-in generator — no external service required.
# Set LLM_API_KEY to get coach-written plans instead.
#
#   LLM_PROVIDER  "deepseek" (default) or "anthropic"
#   LLM_MODEL     defaults to deepseek-v4-pro / claude-opus-5
#   LLM_API_KEY   the provider's key; this alone switches the LLM on
#
# DeepSeek model ids: deepseek-v4-pro (default) or deepseek-v4-flash (~3x
# cheaper, still around a fifth of a cent per plan). NOTE: "deepseek-chat" and
# "deepseek-reasoner" were RETIRED on 2026-07-24 and no longer resolve, even
# though the AI SDK's types still list them — the app rejects them by name.
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=

# DeepSeek only. Thinking mode: adaptive (default) | enabled | disabled.
# Optional reasoning effort: low | medium | high | xhigh | max.
LLM_THINKING=
LLM_REASONING_EFFORT=

# Encrypts secrets at rest in the settings table (currently the Hevy API key)
# with AES-256-GCM. STRONGLY RECOMMENDED: without it the key is stored in
# plaintext, so anyone with a database dump or backup can read it. It does NOT
# protect against compromise of the app host, where this variable also lives.
#
# Must be 32 bytes, base64 or hex. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
#
# Keep it: losing it makes an already-stored key unreadable (the settings page
# then says so, and you re-enter the key). Changing it has the same effect.
# A key stored before this was set is upgraded to encrypted automatically on
# the next boot.
SETTINGS_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# AUTHENTICATION — REQUIRED. The app refuses to serve without it.
# ---------------------------------------------------------------------------
# Unlike LLM_API_KEY (which degrades to the built-in generator) and
# SETTINGS_ENCRYPTION_KEY (which degrades to plaintext storage), a missing auth
# configuration is a hard 503 that names the variables it wants. That is
# deliberate: this app holds a Hevy Pro key and can create routines the Hevy API
# has NO endpoint to delete, so "boots fine, wide open" is not an acceptable
# failure mode.
#
# Before configuring any of this, consider Cloudflare Access or Tailscale
# instead — either puts the same gate in front of the app with zero application
# code and nothing here to maintain. See the README.

# Signs and encrypts the session cookie. Its OWN secret, never reused from
# SETTINGS_ENCRYPTION_KEY — sharing one would mean rotating the Hevy key's
# encryption also logged you out. 32 bytes, base64 or hex:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Rotating this invalidates every existing session — it is the "sign out
# everywhere" button.
AUTH_SESSION_SECRET=

# Which provider serves. Only needed to disambiguate when BOTH a Google client
# and a Hevy allowlist are configured; otherwise it is inferred.
#   google     recommended — real federated identity
#   hevy-key   fallback — a shared-secret password gate, see below
AUTH_PROVIDER=

# --- Provider 1: Google (recommended) --------------------------------------
# Create an OAuth client at https://console.cloud.google.com/apis/credentials
#   Application type:      Web application
#   Authorised redirect URI: <AUTH_ORIGIN>/api/auth/callback/google
#                            e.g. http://localhost:3000/api/auth/callback/google
# Google permits http://localhost redirect URIs, so this is testable locally.
# The consent screen can stay in "Testing" with the owner as the only test user.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The app's public origin, with no trailing path. The redirect URI is built
# from it and must match what is registered on the OAuth client EXACTLY.
AUTH_ORIGIN=http://localhost:3000

# Comma-separated allowlist of Google addresses permitted to sign in. Compared
# case-insensitively, and the address must be email_verified. THIS IS THE GATE:
# with Google configured and this empty, the app refuses to start rather than
# admit every Google account in existence.
#
# NOTE: this app is single-user. A second address here shares the one account
# and the one Hevy key; it does not get data of its own.
AUTH_ALLOWED_EMAILS=

# --- Provider 2: Hevy API key (fallback) -----------------------------------
# BE CLEAR ABOUT WHAT THIS IS: Hevy publishes no OAuth (the pinned spec has 14
# paths, no token endpoint, no securitySchemes — only an api-key header), so
# this is a shared-secret PASSWORD GATE, not federated identity. Whoever holds
# the key can sign in, and signing out cannot revoke it; rotate the key in the
# Hevy app to do that. Its one advantage is needing no external setup, which
# also makes it the way to try the gate before creating an OAuth client.
#
# Comma-separated Hevy user ids (the `data.id` from GET /v1/user/info). Find
# yours with:
#   curl -H "api-key: <your key>" https://api.hevyapp.com/v1/user/info
# Setting this with no Google client selects the Hevy-key gate.
AUTH_ALLOWED_HEVY_USER_IDS=

# --- Session and local development -----------------------------------------
# How long a session lasts, in hours. Default 720 (30 days), max 8760.
AUTH_SESSION_TTL_HOURS=

# Runs the app with NO authentication. Development only — it is REFUSED when
# NODE_ENV=production, and every page shows an "AUTH DISABLED" badge so an open
# instance cannot be mistaken for a protected one. Must be the exact string
# "true". Use it to run locally without setting up a provider; never in a
# deployment.
AUTH_DISABLED=

# MariaDB connection. Required in any deployment; the default below only works
# for a database reachable on localhost with these throwaway credentials.
# Under docker compose the host is the service name, not localhost:
#   DATABASE_URL=mysql://hevy:<password>@db:3306/hevy_planner
DATABASE_URL=mysql://hevy:hevy@127.0.0.1:3306/hevy_planner

# Passwords for the MariaDB container in docker-compose.yml. Compose reads these
# from .env; leaving them unset keeps the insecure defaults, which is fine for a
# local try-out and NOT fine for anything reachable from outside the host.
MARIADB_PASSWORD=
MARIADB_ROOT_PASSWORD=

# Host port the app is published on by docker compose (default 3000). Set this
# if something else already listens on 3000 — the container itself always serves
# on 3000 regardless.
APP_PORT=

# Optional: MariaDB the test suite may CREATE and DROP databases on. Defaults to
# the throwaway server in docker-compose.test.yml (npm run test:db:up).
# TEST_DATABASE_URL=mysql://root:root@127.0.0.1:3307
