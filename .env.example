# Copy to .env and fill in. NEVER commit .env.

# Optional fallback Hevy Pro API key; the primary path is entering it on the
# in-app settings page (stored server-side in SQLite). A key set here is used
# only when no key has been saved in the app.
HEVY_API_KEY=

# LLM used for plan generation, via the Vercel AI SDK.
#
# ALL THREE ARE OPTIONAL. With no LLM_API_KEY the app still generates plans,
# using the deterministic built-in generator — no external service required.
# Set LLM_API_KEY to get coach-written plans instead.
#
#   LLM_PROVIDER  provider name; defaults to "anthropic" (the only one wired up)
#   LLM_MODEL     model id;      defaults to "claude-opus-5"
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=

# Optional: SQLite database file location.
DATABASE_PATH=./data/hevy-planner.sqlite
